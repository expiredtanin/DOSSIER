+    /// Bogenwand auf dem Kreis (Mitte `c`, Radius `r`) von Winkel `a0` nach `a1` (Grad; `a1 > a0` =
+    /// Gegenuhrzeigersinn, Modell-Bulge dann negativ).
+    fn arc_wall(id: &str, c: (f64, f64), r: f64, a0: f64, a1: f64) -> Value {
+        let (p0, p1) = (a0.to_radians(), a1.to_radians());
+        let pt = |a: f64| (c.0 + r * a.cos(), c.1 + r * a.sin());
+        wall(id, pt(p0), pt(p1), Some(-((p1 - p0) / 4.0).tan()))
+    }
