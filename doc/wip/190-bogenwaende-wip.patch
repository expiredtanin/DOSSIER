+/// Bestes Verbinden eines Wandpaars: (Kosten, Bewegungen) über alle Achsschnittpunkte.
+fn connect_pair(pr: &Project, sel: &[(&Wall, Axis)], i: usize, j: usize) -> Option<(f64, Vec<Move>)> {
+    let ((wi, ai), (wj, aj)) = (&sel[i], &sel[j]);
+    let thick = |w: &Wall| {
+        let (lo, hi) = faces(pr, w);
+        (hi - lo).abs()
+    };
+    let tol = 0.5_f64.max(2.0 * thick(wi).max(thick(wj)));
+    let mut best: Option<(f64, Vec<Move>)> = None;
+    for x in connect_hits(ai, aj) {
+        let cand = match (spot(ai, x, tol), spot(aj, x, tol)) {
+            (Some(Spot::End(da, ea)), Some(Spot::End(db, eb))) => (da + db, vec![Move { i, at_end: ea, x }, Move { i: j, at_end: eb, x }]),
+            (Some(Spot::End(da, ea)), Some(Spot::Inner)) => (da, vec![Move { i, at_end: ea, x: tee_face_point(pr, ai, ea, wj, aj, x).unwrap_or(x) }]),
+            (Some(Spot::Inner), Some(Spot::End(db, eb))) => (db, vec![Move { i: j, at_end: eb, x: tee_face_point(pr, aj, eb, wi, ai, x).unwrap_or(x) }]),
+            _ => continue,
+        };
+        if best.as_ref().map_or(true, |b| cand.0 < b.0) {
+            best = Some(cand);
+        }
+    }
+    best
 }
 
