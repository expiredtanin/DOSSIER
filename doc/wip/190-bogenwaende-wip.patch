+        let r = project(vec![arc_wall("a", (0.0, 0.0), 5.0, 0.0, 85.0), arc_wall("b", (-5.0, 5.0), 5.0, 80.0, 5.0)], vec![], vec![]);
+        let n = connect(&r, &["a", "b"]);
+        assert!(close(at(&n, "a", "end"), (0.0, 5.0)));
+        assert!(close(at(&n, "b", "end"), (0.0, 5.0)));
+        assert_circle(&n, "b", (-5.0, 5.0), 5.0);
+        assert!(w_of(&n, "b")["bulge"].as_f64().unwrap() > 0.0, "Drehsinn bleibt");
+    }
+
+    #[test]
+    fn verbinden_gegenrichtungen_bogen_gerade() {
+        // Wie die Bogen–Gerade-Ecke, beide Wände gekehrt: der Bogen beginnt, die Gerade endet an der Ecke.
+        let r = project(vec![arc_wall("a", (0.0, 0.0), 5.0, 85.0, 0.0), wall("b", (0.0, 9.0), (0.0, 5.3), None)], vec![], vec![]);
+        let n = connect(&r, &["b", "a"]);
+        assert!(close(at(&n, "a", "start"), (0.0, 5.0)));
+        assert!(close(at(&n, "a", "end"), (5.0, 0.0)));
+        assert!(close(at(&n, "b", "end"), (0.0, 5.0)));
+        assert_circle(&n, "a", (0.0, 0.0), 5.0);
+        assert!(w_of(&n, "a")["bulge"].as_f64().unwrap() > 0.0);
+        let cuts = joins_of(&n, &["a", "b"]);
+        assert!(cuts[0].start_cut.is_some() && cuts[1].end_cut.is_some());
+    }
+
+    #[test]
+    fn verbinden_t_stoss_gerade_an_bogen() {
+        // Halbkreis r = 5 als Durchgang; radiale Gerade von innen endet 0.4 vor der Achse → an der
+        // Innenfläche r = 4.9; der Bogen bleibt unverändert.
+        let r = project(vec![arc_wall("a", (0.0, 0.0), 5.0, 0.0, 180.0), wall("b", (0.0, 1.0), (0.0, 4.6), None)], vec![], vec![]);
+        let n = connect(&r, &["a", "b"]);
+        assert!(close(at(&n, "b", "end"), (0.0, 4.9)), "{:?}", at(&n, "b", "end"));
+        assert!(close(at(&n, "a", "start"), (5.0, 0.0)) && close(at(&n, "a", "end"), (-5.0, 0.0)));
+        let cuts = joins_of(&n, &["a", "b"]);
+        assert!(cuts[1].end_cut.is_some(), "T-Anschluss am Bogen");
+        assert!(cuts[0].start_cut.is_none() && cuts[0].end_cut.is_none());
+        // Von aussen, mit Überstand durch den Bogen: an der Aussenfläche r = 5.1.
+        let r = project(vec![arc_wall("a", (0.0, 0.0), 5.0, 0.0, 180.0), wall("b", (0.0, 8.0), (0.0, 4.95), None)], vec![], vec![]);
+        let n = connect(&r, &["a", "b"]);
+        assert!(close(at(&n, "b", "end"), (0.0, 5.1)), "{:?}", at(&n, "b", "end"));
+    }
+
+    #[test]
+    fn verbinden_t_stoss_bogen_an_gerade() {
+        // Gerade Durchgangswand x = 0 (y 2…10); der Bogen (r = 5 um (0,0), 0°…85°) endet an ihrer
+        // zugewandten Fläche x = 0.1, auf seinem Kreis.
+        let r = project(vec![wall("a", (0.0, 2.0), (0.0, 10.0), None), arc_wall("b", (0.0, 0.0), 5.0, 0.0, 85.0)], vec![], vec![]);
+        let n = connect(&r, &["a", "b"]);
+        let e = at(&n, "b", "end");
+        assert!(close(e, (0.1, (25.0_f64 - 0.01).sqrt())), "{e:?}");
+        assert_circle(&n, "b", (0.0, 0.0), 5.0);
+        assert!(close(at(&n, "a", "start"), (0.0, 2.0)) && close(at(&n, "a", "end"), (0.0, 10.0)));
+        let cuts = joins_of(&n, &["a", "b"]);
+        let c = cuts[1].end_cut.expect("T-Anschluss des Bogens");
+        assert!((c.point.x - 0.1).abs() < 1e-9 && c.dir.x.abs() < 1e-9, "Schnitt an der Fläche: {c:?}");
+        assert!(cuts[0].start_cut.is_none() && cuts[0].end_cut.is_none());
+    }
+
+    #[test]
+    fn verbinden_flacher_bogen_wie_gerade() {
+        // Bulge 1e-4 (Pfeilhöhe 0.3 mm auf 5.7 m): verhält sich wie die gerade L-Ecke, bleibt aber Bogen.
+        let r = project(vec![wall("a", (0.0, 0.0), (5.7, 0.0), Some(1e-4)), wall("b", (6.0, 0.3), (6.0, 4.4), None)], vec![], vec![]);
+        let before = arc_of_wall(&r, "a");
+        let n = connect(&r, &["a", "b"]);
+        let (ea, sb) = (at(&n, "a", "end"), at(&n, "b", "start"));
+        assert!((ea.0 - 6.0).abs() < 1e-6 && ea.1.abs() < 1e-3, "{ea:?}");
+        assert!(close(ea, sb));
+        assert!(close(at(&n, "a", "start"), (0.0, 0.0)));
+        let after = arc_of_wall(&n, "a");
+        assert!((after.r - before.r).abs() < 1e-6 * before.r, "Radius {} → {}", before.r, after.r);
+        assert!(close((after.center.x, after.center.y), (before.center.x, before.center.y)) || (after.center.x - before.center.x).hypot(after.center.y - before.center.y) < 1e-6 * before.r);
+        assert!(w_of(&n, "a")["bulge"].as_f64().unwrap() > 0.0);
+    }
+
+    #[test]
+    fn verbinden_tangentialstoss() {
+        // Gerade y = 5 berührt den Kreis r = 5 in (0,5); Bogen endet 5° davor, Gerade beginnt 0.3 daneben.
+        let r = project(vec![arc_wall("a", (0.0, 0.0), 5.0, 0.0, 85.0), wall("b", (-0.3, 5.0), (-4.0, 5.0), None)], vec![], vec![]);
+        let n = connect(&r, &["a", "b"]);
+        assert!(close(at(&n, "a", "end"), (0.0, 5.0)), "{:?}", at(&n, "a", "end"));
+        assert!(close(at(&n, "b", "start"), (0.0, 5.0)));
+        assert_circle(&n, "a", (0.0, 0.0), 5.0);
+        // Radiale Stossfuge (tangentialer Übergang).
+        let cuts = joins_of(&n, &["a", "b"]);
+        let c = cuts[0].end_cut.expect("Stoss am Bogenende");
+        assert!(c.dir.x.abs() < 1e-6, "radial: {c:?}");
+        // Kreis–Kreis tangential (S-Kurve): Kreise um (0,0) und (0,10) berühren sich in (0,5).
+        let r = project(vec![arc_wall("a", (0.0, 0.0), 5.0, 0.0, 85.0), arc_wall("b", (0.0, 10.0), 5.0, 265.0, 200.0)], vec![], vec![]);
+        let n = connect(&r, &["a", "b"]);
+        assert!(close(at(&n, "a", "end"), (0.0, 5.0)));
+        assert!(close(at(&n, "b", "start"), (0.0, 5.0)), "{:?}", at(&n, "b", "start"));
+        assert_circle(&n, "b", (0.0, 10.0), 5.0);
+    }
 }
diff --git a/src/commands/cmds/join.arcWalls.test.ts b/src/commands/cmds/join.arcWalls.test.ts
new file mode 100644
index 0000000..b891ac2
--- /dev/null
+++ b/src/commands/cmds/join.arcWalls.test.ts
@@ -0,0 +1,82 @@
+/**
+ * [190] Verbinden (Cmd/Ctrl+J, Befehl „join") mit Bogenwänden: Kern `cmd_wall_edit.rs::connect_ops`.
+ * Enden rücken auf den Kreis–Gerade- bzw. Kreis–Kreis-Schnitt, die Bogenwand behält Mittelpunkt und Radius.
+ */
+import { describe, it, expect } from "vitest";
+import type { Project, Wall } from "../../model/types";
+import { documentFor } from "../../core/document";
+import { applyOps } from "../../core/ops";
+import { sampleProject } from "../../model/sampleProject";
+
+/** Bogenwand auf dem Kreis (Mitte c, Radius r) von a0 nach a1 (Grad, a1 > a0 = Gegenuhrzeigersinn). */
+function arcWall(id: string, c: { x: number; y: number }, r: number, a0: number, a1: number): Wall {
+  const rad = (d: number) => (d * Math.PI) / 180;
+  const pt = (a: number) => ({ x: c.x + r * Math.cos(rad(a)), y: c.y + r * Math.sin(rad(a)) });
+  return { ...line(id, pt(a0), pt(a1)), bulge: -Math.tan(rad(a1 - a0) / 4) };
+}
+
+function line(id: string, a: { x: number; y: number }, b: { x: number; y: number }): Wall {
+  return { id, type: "wall", floorId: "eg", categoryCode: "20", start: a, end: b, wallTypeId: "aw", height: 2.6 };
+}
+
+function join(walls: Wall[]): Wall[] {
+  const p = { ...sampleProject, walls, openings: [], rooms: [], drawings2d: [] } as Project;
+  const ops = documentFor(p).cmdOps({ cmd: "join", ids: walls.map((w) => w.id), stamp: "t" });
+  return applyOps(p, ops).walls;
+}
+
+/** Mittelpunkt und Radius aus Sehne und Modell-Bulge (positiv = Scheitel links der Sehne). */
+function circleOf(w: Wall): { x: number; y: number; r: number } {
+  const b = w.bulge ?? 0;
+  const dx = w.end.x - w.start.x;
+  const dy = w.end.y - w.start.y;
+  const c = Math.hypot(dx, dy);
+  const r = (c * (1 + b * b)) / (4 * Math.abs(b));
+  const sagitta = (Math.abs(b) * c) / 2;
+  // Scheitel auf der Seite sign(b) der linken Normalen; Mitte um (Pfeilhöhe − r) von der Sehnenmitte.
+  const k = Math.sign(b) * (sagitta - r);
+  return { x: (w.start.x + w.end.x) / 2 + (-dy / c) * k, y: (w.start.y + w.end.y) / 2 + (dx / c) * k, r };
+}
+
+describe("[190] Cmd+J verbindet Bogenwände", () => {
+  it("Bogen–Gerade-Ecke: beide Enden auf dem Achsschnittpunkt, Kreis bleibt", () => {
+    const walls = join([arcWall("a", { x: 0, y: 0 }, 5, 0, 85), line("b", { x: 0, y: 5.3 }, { x: 0, y: 9 })]);
+    const a = walls.find((w) => w.id === "a")!;
+    const b = walls.find((w) => w.id === "b")!;
+    expect(a.end.x).toBeCloseTo(0, 6);
+    expect(a.end.y).toBeCloseTo(5, 6);
+    expect(b.start.x).toBeCloseTo(0, 6);
+    expect(b.start.y).toBeCloseTo(5, 6);
+    expect(a.bulge).toBeLessThan(0);
+    const c = circleOf(a);
+    expect(c.r).toBeCloseTo(5, 6);
+    expect(Math.hypot(c.x, c.y)).toBeCloseTo(0, 6);
+  });
+
+  it("Bogen–Bogen-Ecke: Kreis–Kreis-Schnitt nahe den Enden", () => {
+    const walls = join([arcWall("a", { x: 0, y: 0 }, 5, 0, 85), arcWall("b", { x: -5, y: 5 }, 5, 5, 80)]);
+    const a = walls.find((w) => w.id === "a")!;
+    const b = walls.find((w) => w.id === "b")!;
+    expect(a.end.x).toBeCloseTo(0, 6);
+    expect(a.end.y).toBeCloseTo(5, 6);
+    expect(b.start.x).toBeCloseTo(0, 6);
+    expect(b.start.y).toBeCloseTo(5, 6);
+    const cb = circleOf(b);
+    expect(cb.r).toBeCloseTo(5, 6);
+    expect(cb.x).toBeCloseTo(-5, 6);
+    expect(cb.y).toBeCloseTo(5, 6);
+  });
+
+  it("Gerade an Bogen (T-Stoss): die Gerade endet an der zugewandten Bogenfläche, der Bogen bleibt", () => {
+    const arc = arcWall("a", { x: 0, y: 0 }, 5, 0, 180);
+    const walls = join([arc, line("b", { x: 0, y: 1 }, { x: 0, y: 4.6 })]);
+    const a = walls.find((w) => w.id === "a")!;
+    const b = walls.find((w) => w.id === "b")!;
+    // Wandtyp „aw" des Beispielprojekts, Referenz Mitte: Innenfläche bei r = 5 − Dicke/2.
+    expect(b.end.x).toBeCloseTo(0, 6);
+    expect(b.end.y).toBeGreaterThan(4.6);
+    expect(b.end.y).toBeLessThan(5);
+    expect(a.start).toEqual(arc.start);
+    expect(a.end).toEqual(arc.end);
+  });
+});
