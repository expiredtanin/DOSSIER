+/// Tangentiale Berührung (Gerade/Kreis, Kreis/Kreis) gilt bis zu diesem Abstand als Treffer (Meter).
+const TANGENT_TOL: f64 = 1e-6;
+
+/// Achsschnittpunkte zweier Wände für das Verbinden ([190]): Gerade × Gerade (nicht fast parallel),
+/// Gerade × Kreis, Kreis × Kreis; tangentiale Berührung ergibt den Berührpunkt (auch knapp daneben,
+/// [`TANGENT_TOL`]). Bögen auf demselben Kreis treffen sich nicht (das ist Verketten).
+fn connect_hits(a: &Axis, b: &Axis) -> Vec<P> {
+    let tangent_line = |c: P, r: f64, l: &Axis| -> Option<P> {
+        let t = (c.x - l.a.x) * l.u.x + (c.y - l.a.y) * l.u.y;
+        let f = P::new(l.a.x + l.u.x * t, l.a.y + l.u.y * t);
+        ((dist(f, c) - r).abs() <= TANGENT_TOL).then_some(f)
+    };
+    let pts = match (&a.arc, &b.arc) {
+        (None, None) => {
+            if cross(a.u, b.u).abs() < 0.02 {
+                return vec![];
+            }
+            kernel2d::line_intersect(a.a, a.u, b.a, b.u).into_iter().collect()
+        }
+        (None, Some(w)) | (Some(w), None) => {
+            let l = if a.arc.is_none() { a } else { b };
+            match tangent_line(w.center, w.r, l) {
+                Some(f) => vec![f],
+                None => circle_line(w.center, w.r, &Line { point: l.a, dir: l.u }),
+            }
+        }
+        (Some(v), Some(w)) => {
+            let d = dist(v.center, w.center);
+            if d < EPS_GEO && (v.r - w.r).abs() < EPS_GEO {
+                return vec![];
+            }
+            let touch = d > 1e-12 && ((d - (v.r + w.r)).abs() <= TANGENT_TOL || (d - (v.r - w.r).abs()).abs() <= TANGENT_TOL);
+            if touch {
+                // Berührpunkt auf der Mittellinie, auf dem ersten Kreis, nächst am zweiten.
+                let u = P::new((w.center.x - v.center.x) / d, (w.center.y - v.center.y) / d);
+                let c = [1.0, -1.0].map(|s| P::new(v.center.x + u.x * v.r * s, v.center.y + u.y * v.r * s));
+                let best = if (dist(c[0], w.center) - w.r).abs() <= (dist(c[1], w.center) - w.r).abs() { c[0] } else { c[1] };
+                vec![best]
+            } else {
+                circle_circle(v.center, v.r, w.center, w.r)
+            }
+        }
+    };
+    pts.into_iter().filter(|p| fin(*p)).collect()
+}
